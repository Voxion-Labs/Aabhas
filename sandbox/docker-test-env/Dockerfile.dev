FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        gdb \
        git \
        pkg-config \
        rustc \
        cargo \
        valgrind \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 aabhas \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash aabhas \
    && install -d -o 10001 -g 10001 -m 0750 /workspace

WORKDIR /workspace
USER 10001:10001
ENV CARGO_HOME=/home/aabhas/.cargo \
    RUSTUP_HOME=/home/aabhas/.rustup

CMD ["bash"]
